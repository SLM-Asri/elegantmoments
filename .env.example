# ---- Server ----
PORT=3000
NODE_ENV=development
# Set to your real domain in production, e.g. https://www.yourdomain.com
SITE_URL=http://localhost:3000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=elegant_moments

# ---- Admin login (used by `npm run db:setup`) ----
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@elegantmoments.lk
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Security ----
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Set true only when the site runs on HTTPS
COOKIE_SECURE=false
# Set true if behind a proxy/load balancer (nginx, cPanel, Render...)
TRUST_PROXY=false

# ---- Email notifications (optional; leave SMTP_HOST empty to disable) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Elegant Moments <studioelegantmoments@gmail.com>"
# Where new booking / message alerts are sent
NOTIFY_EMAIL=studioelegantmoments@gmail.com

# ---- Booking capacity per day (confirmed bookings) ----
MAX_WEDDINGS_PER_DAY=1
MAX_PHOTOGRAPHY_PER_DAY=4

# ---- Spam protection ----
# Max booking/contact submissions per visitor (IP) per hour
RATE_LIMIT_FORMS_PER_HOUR=15
